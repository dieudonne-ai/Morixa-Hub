# ── Sécurité (générer avec : python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=
JWT_SECRET=

# ── Base de données (coller l'URL fournie par Neon)
DATABASE_URL=

# ── Cloudflare R2 (remplir après création du bucket)
USE_R2=true
R2_ACCOUNT_ID=votre_account_id
R2_ACCESS_KEY_ID=votre_access_key
R2_SECRET_ACCESS_KEY=votre_secret_key
R2_BUCKET_NAME=morixa-uploads
R2_PUBLIC_URL=https://votre-domaine-r2.com

# ── Emails transactionnels (Resend, gratuit jusqu'à 100/jour)
RESEND_API_KEY=
FROM_EMAIL=Morixa Hub <onboarding@resend.dev>
FRONTEND_URL=https://morixa-hub-api.onrender.com

# ── Administration
# Emails (séparés par des virgules) autorisés à utiliser le panel admin
# et à modérer les signalements. Mettez ici l'email de VOTRE compte
# médecin sur Morixa Hub (pas votre email personnel).
ADMIN_EMAILS=

# ── Digest hebdomadaire par email
# Secret partagé pour déclencher /api/admin/digest/run depuis un cron
# externe gratuit (cron-job.org, GitHub Actions...). Générez une valeur
# aléatoire avec : python -c "import secrets; print(secrets.token_hex(16))"
DIGEST_SECRET=

# ── IA (optionnelle — laissez AI_PROVIDER=none pour désactiver)
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=

# ── Environnement
FLASK_DEBUG=false
